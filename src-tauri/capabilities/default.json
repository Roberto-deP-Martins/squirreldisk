{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability allowing file deletion",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "/path/to/pdu-binary",
          "cmd": "/path/to/pdu-binary",
          "args": true
        }
      ]
    }
  ]
}